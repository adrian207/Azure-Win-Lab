# ============================================================================
# Azure Hybrid Lab - DOCKER EDITION - Configuration
# ============================================================================
# This is the HYBRID architecture with:
#   - Docker Host running all Linux workloads + SQL Server + Samba AD
#   - Windows 11 for client testing
# Cost: ~$70/month (74% savings vs full Windows architecture)
# ============================================================================

# Azure Configuration
location         = "East US"
environment_name = "lab"

# Authentication
admin_username = "labadmin"
admin_password = "ChangeMe123!@#"  # CHANGE THIS!

# SQL Server Configuration (runs in Docker)
sql_admin_username = "sa"
sql_admin_password = "SQL_Pa$$w0rd_2024"  # CHANGE THIS!

# Linux/Docker Configuration
linux_admin_username = "azureuser"
ssh_public_key       = ""  # Paste your SSH public key here (optional)

# Active Directory Configuration (Samba AD DC in Docker)
domain_name = "lab.local"

# VM Sizes
docker_host_vm_size = "Standard_D4s_v3"  # 4 vCPU, 16 GB RAM (all containers)
workstation_vm_size = "Standard_D2s_v3"  # 2 vCPU, 8 GB RAM (Windows 11)

# Auto-shutdown (saves costs)
enable_auto_shutdown  = true
auto_shutdown_time    = "1900"  # 7:00 PM
auto_shutdown_timezone = "Eastern Standard Time"

# Resource Tags
tags = {
  Project      = "Hybrid Docker Lab"
  Purpose      = "Testing and Demos"
  Owner        = "Your Name"
  CostCenter   = "IT"
  AutoShutdown = "Enabled"
  Architecture = "Docker"
}

# ============================================================================
# WHAT THIS DEPLOYS:
# ============================================================================
# 1x Docker Host (Ubuntu 22.04) running:
#    - Samba AD DC (Active Directory replacement)
#    - SQL Server 2022 on Linux
#    - PostgreSQL 16
#    - MongoDB 7
#    - Redis 7
#    - Nginx web server
#    - Portainer (Docker GUI)
#    - GitLab CE (DevOps)
#    - Jenkins (CI/CD)
#    - Adminer (Database GUI)
#
# 1x Windows 11 Workstation
# 1x Azure Bastion Host
#
# Total monthly cost (12hr/day): ~$70
# Previous architecture cost: ~$270
# Savings: $200/month (74%)
# ============================================================================
