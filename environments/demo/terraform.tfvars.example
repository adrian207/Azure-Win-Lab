# Demo Environment Configuration
# Optimized for demos and presentations

environment_name = "demo"
location         = "East US"

vnet_address_space = ["10.2.0.0/16"]

# VM Credentials
admin_username = "labadmin"
admin_password = "CHANGE_ME"

sql_admin_username = "sqladmin"
sql_admin_password = "CHANGE_ME"

# Performance-oriented VM sizes for smooth demos
server_vm_size     = "Standard_D4s_v3"
workstation_vm_size = "Standard_D4s_v3"
sql_vm_size        = "Standard_D8s_v3"

# Disable auto-shutdown during demo periods
enable_auto_shutdown   = false

tags = {
  Environment  = "Demo"
  Project      = "Windows Server Lab"
  Purpose      = "Customer Demos and Presentations"
  AutoShutdown = "Disabled"
}

