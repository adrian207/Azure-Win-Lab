# Environment Variables for Azure Hybrid Infrastructure Platform
# 
# Copy this file to .env and fill in your values
# Load with: source .env
# 
# WARNING: .env is in .gitignore - never commit credentials!

# Azure Authentication (optional if using az login)
# export ARM_CLIENT_ID="00000000-0000-0000-0000-000000000000"
# export ARM_CLIENT_SECRET="your-client-secret"
# export ARM_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
# export ARM_TENANT_ID="00000000-0000-0000-0000-000000000000"

# Terraform Variables
export TF_VAR_environment_name="standard"
export TF_VAR_location="East US"

# VM Credentials
export TF_VAR_admin_username="labadmin"
export TF_VAR_admin_password="CHANGE_ME_SecurePassword123!"

# SQL Server Credentials
export TF_VAR_sql_admin_username="sqladmin"
export TF_VAR_sql_admin_password="CHANGE_ME_SQLPassword123!"

# Linux Configuration
export TF_VAR_linux_admin_username="azureuser"
# Option 1: Use SSH key (recommended)
export TF_VAR_ssh_public_key="$(cat ~/.ssh/azure_lab_rsa.pub 2>/dev/null || echo '')"
# Option 2: Use password (set ssh_public_key to empty)
# export TF_VAR_ssh_public_key=""

# Monitoring Configuration
export TF_VAR_alert_email_addresses='["your-email@example.com"]'

# Cost Management
export TF_VAR_enable_auto_shutdown="true"
export TF_VAR_auto_shutdown_time="1900"

# Terraform Logging (uncomment for debug)
# export TF_LOG="DEBUG"
# export TF_LOG_PATH="./terraform-debug.log"

# Convenience aliases
alias tf="terraform"
alias tfp="terraform plan"
alias tfa="terraform apply"
alias tfd="terraform destroy"
alias tfo="terraform output"

echo "✓ Environment variables loaded"
echo "  Environment: $TF_VAR_environment_name"
echo "  Location: $TF_VAR_location"
echo "  Admin User: $TF_VAR_admin_username"

